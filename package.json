{
  "name": "angkorgit-zh",
  "version": "0.27.9",
  "private": true,
  "description": "AngKorGit —— 一款受吴哥窟匠心启发的现代、快速、美观的跨平台 Git 客户端",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run --filter @angkorgit/desktop dev",
    "tauri": "bun run --filter @angkorgit/desktop tauri",
    "tauri:dev": "bun run --filter @angkorgit/desktop tauri dev",
    "tauri:build": "bun run --filter @angkorgit/desktop tauri build",
    "release:mac": "bun run tauri:build && open apps/desktop/src-tauri/target/release/bundle/dmg",
    "install:mac": "pkill -x angkorgit || true; sleep 1; rm -rf /Applications/AngKorGit.app && ditto apps/desktop/src-tauri/target/release/bundle/macos/AngKorGit.app /Applications/AngKorGit.app && open -a /Applications/AngKorGit.app",
    "build": "bun run --filter '*' build",
    "lint": "bun run --workspaces --if-present lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "localize": "bun run scripts/localize.mjs",
    "test:localize": "node --test tests/localize.test.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:dict": "node scripts/check-dict.mjs",
    "website": "bun run --filter @angkorgit/website dev",
    "website:build": "bun run --filter @angkorgit/website build",
    "website:preview": "bun run --filter @angkorgit/website preview",
    "website:images": "bun run --filter @angkorgit/website images",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ]
}
