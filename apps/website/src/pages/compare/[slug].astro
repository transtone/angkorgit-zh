---
import Page from '../../layouts/Page.astro';
import InstallCta from '../../components/InstallCta.astro';
import Faq from '../../components/Faq.astro';
import { COMPETITORS, type Competitor } from '../../lib/compare';

export function getStaticPaths() {
  return COMPETITORS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Competitor };
const others = COMPETITORS.filter((o) => o.slug !== c.slug);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Page
  title={c.title}
  description={c.description}
  kicker={c.kicker}
  heading={c.heading}
  crumbs={[
    { href: '/compare/', label: 'Compare' },
    { href: `/compare/${c.slug}/`, label: c.short },
  ]}
  jsonLd={[faqLd]}
>
  <Fragment slot="intro">{c.intro.map((p) => <p>{p}</p>)}</Fragment>

  <section class="mt-14" aria-labelledby="facts">
    <h2 id="facts" class="display text-3xl">Side by side</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[40rem] border-collapse text-[15px]">
        <thead>
          <tr class="border-b border-border text-left">
            <th scope="col" class="w-32 py-3 pr-4 font-mono text-xs font-medium uppercase tracking-[0.14em] text-faint"></th>
            <th scope="col" class="py-3 pr-4 font-medium text-foreground">{c.name}</th>
            <th scope="col" class="py-3 font-medium text-primary">AngKorGit</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-subtle">
          {
            c.facts.map((row) => (
              <tr class="align-top">
                <th scope="row" class="py-4 pr-4 text-left font-mono text-xs font-medium uppercase tracking-[0.14em] text-faint">{row.label}</th>
                <td class="py-4 pr-6 leading-relaxed text-muted">{row.theirs}</td>
                <td class="py-4 leading-relaxed text-foreground">{row.ours}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-14 grid gap-10 lg:grid-cols-2" aria-label="What each one does that the other does not">
    <div>
      <h2 class="display text-3xl">What {c.short} has that I don't</h2>
      <ul class="mt-5 space-y-3 text-[15px] leading-relaxed text-muted">
        {c.theyDo.map((item) => <li class="flex gap-3"><span aria-hidden="true" class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-faint"></span><span>{item}</span></li>)}
      </ul>
    </div>
    <div>
      <h2 class="display text-3xl">What AngKorGit has that {c.short} doesn't</h2>
      <ul class="mt-5 space-y-3 text-[15px] leading-relaxed text-muted">
        {c.weDo.map((item) => <li class="flex gap-3"><span aria-hidden="true" class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span><span>{item}</span></li>)}
      </ul>
    </div>
  </section>

  <figure class="mt-14">
    <picture>
      <source srcset="/screenshots/graph-light.webp" media="(prefers-color-scheme: light)" />
      <img src="/screenshots/graph.webp" alt="AngKorGit showing a commit graph with branch chips, the working copy panel and a commit's files" class="w-full rounded-lg border border-border-subtle shadow-soft" loading="lazy" width="1512" height="949" />
    </picture>
    <figcaption class="mt-3 text-sm text-faint">The graph, the working copy and the inspector. Everything on this page is the app as it ships.</figcaption>
  </figure>

  <Faq items={c.faq} />

  <InstallCta heading={`Try it next to ${c.short}`} />

  <nav class="mt-12 text-sm text-muted" aria-label="Other comparisons">
    Also compared:
    {others.map((o, i) => (<><a href={`/compare/${o.slug}/`} class="link-underline text-foreground">{o.short}</a>{i < others.length - 1 ? ', ' : '.'}</>))}
    Or see <a href="/#box" class="link-underline text-foreground">everything in the box</a>.
  </nav>
</Page>
