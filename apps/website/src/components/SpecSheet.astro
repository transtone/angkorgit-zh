---
import Commit from './Commit.astro';

const groups: { title: string; items: string[] }[] = [
  {
    title: '每天',
    items: [
      '暂存文件、代码块或单行',
      '带摘要和说明提交，草稿按仓库保存',
      '修订、还原、重置（软、混合、硬）',
      '提交、检出、合并、变基的撤销与重做',
      '工作副本监听，让 WIP 行始终准确',
      '后台自动拉取',
    ],
  },
  {
    title: 'Branches',
    items: [
      '侧边栏中的分支文件夹',
      '把一个分支拖到另一个分支上以合并或变基',
      '交互式变基：重排、压缩、改写、丢弃',
      '拣选一个或多个提交，可携带来源引用',
      '工作树：列表、创建、移除、清理',
      '暂存、标签、子模块',
    ],
  },
  {
    title: '阅读更改',
    items: [
      'Inline or side by side, word level highlighting',
      'Whole file view, image diffs, a minimap you can click',
      'Previous and next change, previous and next file',
      'Commit search by text, author, branch, or hash',
      'File history and blame, with a jump back to the commit',
      'Commit details with parents, refs, and per-file counts',
    ],
  },
  {
    title: '远端与账户',
    items: [
      '抓取、拉取、推送，使用 git 自身的凭据链',
      'SSH 密钥与访问令牌。一个主机可关联多个账户',
      '身份配置按仓库保存，绝不写入全局 gitconfig',
      '拉取请求：列表、检出、创建、挑选审查人（GitHub、GitLab、Bitbucket）',
      '通过你现有的 git 配置进行提交签名（SSH 或 GPG）',
    ],
  },
  {
    title: 'Conflicts',
    items: [
      '两侧对齐，每侧带行号',
      '选择一侧、一块或一行',
      '就地编辑结果，或编辑整个文件',
      '按需对冲突进行 AI 解释',
    ],
  },
  {
    title: '其余',
    items: [
      '⌘K 命令面板包含所有命令，菜单项旁显示快捷键',
      '16 款主题，深浅双色，五种强调色',
      '每个仓库内置终端',
      '任何破坏性操作前都有真正的确认对话框',
      '来自 GitHub releases 的签名验证更新',
    ],
  },
];

const notInBox = [
  ['In-app pull request review', 'The forge does this better, with CI logs and suggestions. There is an Open in browser button.'],
  ['Telemetry, accounts, a cloud', 'Nothing phones home. There is nothing to sign up for.'],
  ['A plugin marketplace', 'Not yet. The palette and sidebar are list driven, so it is possible later.'],
];
---

<Commit id="box" class="py-20 lg:py-28">
  <div class="container-site rail-offset">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <div data-reveal>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-primary">规格表</p>
        <h2 class="display mt-3 text-4xl leading-[1.02] sm:text-5xl">开箱即得的一切</h2>
        <p class="mt-6 text-[17px] leading-relaxed text-muted">
          整个清单，用大白话讲。如果这里没有，应用里就没有。
        </p>
      </div>
      <div class="grid gap-x-10 gap-y-9 sm:grid-cols-2" data-reveal style={{ '--reveal-delay': '100ms' }}>
        {
          groups.map((group) => (
            <div>
              <h3 class="font-mono text-xs uppercase tracking-[0.14em] text-faint">{group.title}</h3>
              <ul class="mt-3 divide-y divide-border-subtle border-y border-border-subtle">
                {group.items.map((item) => (
                  <li class="py-2 text-[14px] leading-snug text-foreground/90">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-20 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]" data-reveal>
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-faint">而不包括</p>
        <h3 class="display mt-3 text-3xl leading-[1.05] sm:text-4xl">我刻意不做的事</h3>
      </div>
      <dl class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
        {
          notInBox.map(([term, why]) => (
            <div class="border-l-2 border-border pl-4">
              <dt class="text-[15px] font-medium text-foreground">{term}</dt>
              <dd class="mt-1 text-[14px] leading-relaxed text-muted">{why}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</Commit>
