---
import { SITE } from '../lib/site';
import { PLATFORMS } from '../lib/install';

interface Props {
  heading?: string;
  only?: string;
}

const { heading = 'Try it on your own repository', only } = Astro.props;
const version = SITE.latestVersion;
const platforms = only ? PLATFORMS.filter((p) => p.id === only) : PLATFORMS;
---

<section class="mt-16 rounded-lg border border-border-subtle bg-surface p-6 sm:p-8" aria-labelledby="install-cta">
  <h2 id="install-cta" class="display text-3xl">{heading}</h2>
  <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-muted">
    Version {version}. Free, MIT licensed, no account, no telemetry. The app updates itself after the first install.
  </p>
  <ul class="mt-6 flex flex-wrap gap-3">
    {
      platforms.map((p) => (
        <li>
          <a
            href={SITE.assetUrl(version, p.asset)}
            class="inline-flex h-10 items-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
          >
            {p.name}
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 5v14m0 0 6-6m-6 6-6-6" />
            </svg>
          </a>
        </li>
      ))
    }
    <li>
      <a href="/#install" class="inline-flex h-10 items-center rounded-md border border-border px-4 text-sm text-muted transition-colors hover:text-foreground">
        All downloads and Homebrew
      </a>
    </li>
  </ul>
</section>
